# ==============================================================================
# WealthPilot — Environment Configuration Template
# ==============================================================================

# --- Execution Engine ---
# Options: "live"  (real Apify platform actors & live LLM reasoning)
#          "dummy" (offline deterministic mode for testing without API keys)
WEALTHPILOT_MODE=live

# --- Apify Platform Integration ---
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_USERNAME=your_apify_username
APIFY_ACTOR_ID=your_deployed_actor_id   # e.g., hvBqBqzKbgPBjXYhx or username~wealthpilot-orchestrator

# --- LLM Provider & Reasoning Gateway ---
# Options: "groq", "openai", "gemini", "anthropic", "apify-openrouter"
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile       # or "gpt-4o-mini", "claude-3-5-sonnet", etc.

# --- Safety & Token Budgets ---
LLM_MAX_TOKENS_PER_CALL=1500
LLM_MAX_TOKENS_PER_RUN=50000

# --- Web Server Configuration ---
PORT=8000
