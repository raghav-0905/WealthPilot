# ==============================================================================
# WealthPilot Environment Variables Template (.env.example)
# ==============================================================================

# --- Execution Engine ---
# Set to "live" for production / Apify Actor & LLM execution, or "dummy" for offline simulation
WEALTHPILOT_MODE=live

# --- Apify Platform Settings ---
# <-- ACTION REQUIRED: Paste your Apify API Token (found in Apify Console -> Settings -> Integrations)
APIFY_TOKEN=apify_api_your_token_here
APIFY_USERNAME=outshining_swan
APIFY_ACTOR_ID=hvBqBqzKbgPBjXYhx

# --- LLM Provider & Reasoning Gateway ---
LLM_PROVIDER=groq
# <-- ACTION REQUIRED: Paste your LLM API Key (e.g. Groq gsk_..., OpenAI sk-..., or Apify token)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Safety & Token Budgets ---
LLM_MAX_TOKENS_PER_CALL=1500
LLM_MAX_TOKENS_PER_RUN=50000

# --- Server Port (Render / Railway injects $PORT automatically) ---
PORT=8000
