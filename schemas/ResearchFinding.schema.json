{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchFinding",
  "type": "object",
  "required": [
    "topic",
    "relevance",
    "confidence",
    "affects",
    "summary",
    "sources"
  ],
  "properties": {
    "topic": { "type": "string" },
    "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
