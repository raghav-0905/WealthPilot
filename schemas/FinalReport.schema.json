{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalReport",
  "type": "object",
  "required": [
    "clientId",
    "goal",
    "rankedOptions",
    "explanation",
    "arbitrationLog",
    "taskGraph"
  ],
  "properties": {
    "clientId": { "type": "string" },
    "goal": { "type": "string" },
    "rankedOptions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "explanation": { "type": "string" },
    "arbitrationLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict", "decision", "reasoning"],
        "properties": {
          "conflict": { "type": "string" },
          "decision": { "type": "string" },
          "reasoning": { "type": "string" }
        }
      }
    },
    "taskGraph": {
      "type": "object"
    }
  }
}
